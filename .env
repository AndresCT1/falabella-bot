# Copia este archivo como .env y completa los valores

# Token del bot de Telegram (obtenlo desde @BotFather)
TELEGRAM_TOKEN=8847621711:AAEyI-hrYpaCEHIP_c1aUqV4FCIQ2ToiMc4

# URL de la base de datos (dejar vacío para SQLite local)
# Railway la provee automáticamente como variable de entorno
# Ejemplo PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Intervalo de verificación de precios en minutos (default: 30)
CHECK_INTERVAL_MINUTES=30

# Ruta de la base de datos SQLite (default: falabella_prices.db)
DATABASE_PATH=falabella_prices.db

# Máximo de productos a registrar por keyword (default: 10)
MAX_PRODUCTS_PER_KEYWORD=10

# Bajada mínima en Soles para enviar notificación (default: 0.0 = cualquier bajada)
PRICE_DROP_THRESHOLD=0.0

# Descuento mínimo en % para alertas automáticas de __top_ofertas__ (default: 30)
TOP_OFFERS_MIN_DISCOUNT=30

TIENDAS_OFICIALES=FALABELLA,TOTTUS,SODIMAC,HOMECENTER

# Chat ID del administrador — solo este usuario puede usar comandos restringidos
# Puedes obtenerlo enviando cualquier mensaje al bot y revisando los logs
ADMIN_CHAT_ID=7033993768